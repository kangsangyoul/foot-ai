# ==========================================
# FOOT AI - 환경 변수 설정
# ==========================================
# 아래 API 키들을 입력하세요. 모든 키가 필수는 아니지만,
# 더 많은 키를 설정할수록 더 많은 AI 모델을 사용할 수 있습니다.

# ==========================================
# 필수 API 키 (최소 1개 이상 필요)
# ==========================================

# Anthropic API Key (Claude 3.5 Sonnet, Claude Opus)
# 가입: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (GPT-4, GPT-4o)
# 가입: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# 선택 API 키 (더 많은 AI 융합을 위해)
# ==========================================

# Google API Key (Gemini Pro)
# 가입: https://makersuite.google.com/app/apikey
# 무료 티어 제공!
GOOGLE_API_KEY=your_google_api_key_here

# Cohere API Key (Command)
# 가입: https://dashboard.cohere.com/api-keys
# 무료 티어 제공!
COHERE_API_KEY=your_cohere_api_key_here

# Mistral API Key (Mistral Large)
# 가입: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Replicate API Token (Llama 3 70B)
# 가입: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# ==========================================
# 추천 설정
# ==========================================
# 최소 설정 (무료): ANTHROPIC_API_KEY + GOOGLE_API_KEY
# 권장 설정: 위 모든 키 (최대 8개 AI 모델 융합!)
# ==========================================
